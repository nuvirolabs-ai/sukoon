# Android debug client only. Never commit a personal Tailscale or LAN address.
# Copy to .env.android.local (gitignored) before `npm run android:sync`.
SUKOON_RUNTIME_PROFILE=ANDROID_DEVICE_DEV
SUKOON_ANDROID_SERVER_URL="http://<REACHABLE_MAC_HOST>:3100"
NEXT_PUBLIC_SUKOON_API_BASE_URL="http://<REACHABLE_MAC_HOST>:3100"
SUKOON_TRUSTED_ORIGINS="http://<REACHABLE_MAC_HOST>:3100"
BETTER_AUTH_TRUSTED_ORIGINS="http://<REACHABLE_MAC_HOST>:3100"
# Optional production/staging host for later App Links (no autoVerify until the domain is live):
# SUKOON_APP_LINK_HOST="app.example.test"
