# Local development only. Never commit a usable secret or a shared database URL.
APP_ENV=local
DATABASE_URL="postgresql://<local-user>@localhost:5432/sukoon_s02_local_<unique-suffix>?schema=public"
TEST_DATABASE_URL="postgresql://<local-user>@localhost:5432/sukoon_s02_test_<unique-suffix>?schema=public"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3100"
SUKOON_AUTH_MAILBOX="memory"

# S08 provider bindings. These local/test adapters are deliberately rejected
# by provider validation when APP_ENV or NODE_ENV is production.
SUKOON_STORAGE_PROVIDER="local"
SUKOON_SCANNER_PROVIDER="unconfigured"
SUKOON_EMAIL_PROVIDER="sandbox"
SUKOON_PUSH_PROVIDER="unconfigured"
SUKOON_OCR_PROVIDER="unconfigured"
SUKOON_PARSER_PROVIDER="unconfigured"
SUKOON_AI_PROVIDER="unconfigured"
SUKOON_CONNECTOR_PROVIDER="unconfigured"
# Local ClamAV is opt-in only after host installation/signature-update approval.
# SUKOON_LOCAL_SCANNER=clamav
# SUKOON_CLAMSCAN_PATH=/opt/homebrew/bin/clamscan
# SUKOON_CLAMAV_DATABASE=/Users/tanutejas/Documents/Sukoon/.data/clamav/signatures

# Android debug client. Never commit a personal Tailscale/LAN IP.
# Copy .env.android.local.example to .env.android.local for device testing.
# SUKOON_RUNTIME_PROFILE=ANDROID_DEVICE_DEV
# SUKOON_ANDROID_SERVER_URL="http://<REACHABLE_MAC_HOST>:3100"
# NEXT_PUBLIC_SUKOON_API_BASE_URL="http://<REACHABLE_MAC_HOST>:3100"
# SUKOON_TRUSTED_ORIGINS="http://<REACHABLE_MAC_HOST>:3100"
# BETTER_AUTH_TRUSTED_ORIGINS="http://<REACHABLE_MAC_HOST>:3100"

