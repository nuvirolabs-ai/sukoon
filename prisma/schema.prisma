  actualCostPaise    BigInt?
  cancelledAt        DateTime?
  createdAt          DateTime     @default(now())
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy        User         @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  property           Property?    @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, requestedByUserId, createdAt])
  @@index([workspaceId, propertyId, createdAt])
}

