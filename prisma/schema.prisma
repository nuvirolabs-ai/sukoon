model ConstructionDocumentLink {
  document PropertyDoc @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  id String @id
  workspaceId String
  projectId String
  stageId String?
  taskId String?
  updateId String?
  documentId String
  documentVersionId String
  category String
  // Construction OS Core 1.0: contextual link target (project/stage/milestone/
  // work/decision/issue/inspection/change/commitment/expense/material/order/
  // delivery/handover). documentId/versionId remain the protected Vault record.
  contextType String @default("PROJECT")
  contextId String?
  label String @default("")
  createdAt DateTime @default(now())
  project ConstructionProject @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  // One Vault version may be relevant in several contexts (stage + milestone
  // + inspection); the same version in the same context links only once.
  // NULL contextIds are kept distinct by the database, so the application
  // duplicate check below remains authoritative for unscoped links.
  @@unique([projectId, documentVersionId, contextType, contextId])
}

