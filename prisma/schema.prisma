  @@unique([projectId, requestKey])
  @@index([projectId, createdAt])
}

// Construction OS Core 1.0 domain delta. All tables carry workspaceId +
// projectId with a composite project FK (cascade) so tenant isolation matches
// the existing Construction tables. Cross-object links inside Construction
// are plain validated string references (same convention as dependsOnId).

model ConstructionPlanVersion {
  id String @id
  workspaceId String
  projectId String
  versionNumber Int
  label String @default("")
  status String @default("DRAFT")
  createdBy String?
  notes String @default("")
  createdAt DateTime @default(now())
  activatedAt DateTime?
  supersededAt DateTime?
  project ConstructionProject @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  @@unique([id, projectId, workspaceId])
  @@unique([projectId, versionNumber])
  @@index([projectId, status])
}

