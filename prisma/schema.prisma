// Sukoon's durable local foundation. Auth tables follow Better Auth's Prisma
// adapter contract; application records carry workspace ownership all the way
// down to child rows so the database cannot silently cross tenant boundaries.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  role                String               @default("owner")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  accounts            Account[]
  workspace           Workspace?
  consents            ConsentRecord[]
  privacyRequests     PrivacyRequest[]
  idempotency         IdempotencyRecord[]
  ruleAuditEvents     RuleAuditEvent[]
  assessmentSnapshots AssessmentSnapshot[]
  shareOperations     ShareOperation[]
  exportPackages      ExportPackage[]
  assistantRequests   AssistantRequest[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  purchaseWorkspaces PurchaseWorkspace[]
  processingControl ProcessingControl?
  id                  String                 @id
  ownerUserId         String                 @unique
  name                String
  lang                String                 @default("en")
  referralCode        String                 @default("")
  version             Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  owner               User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  properties          Property[]
  docs                PropertyDoc[]
  bills               Bill[]
  maintenance         Maintenance[]
  timeline            TimelineEvent[]
  shares              ShareLink[]
  tenants             Tenant[]
  bookings            Booking[]
  reminders           Reminder[]
  durableReminders    DurableReminder[]
  reminderAttempts    ReminderAttempt[]
  listings            Listing[]
  projects            ConstructionProject[]
  propertyHistory     PropertyHistory[]
  documentVersions    DocumentVersion[]
  parsingRuns         DocumentParsingRun[]
  ocrRuns             DocumentOcrRun[]
  aiRuns              AiExtractionRun[]
  aiProposals         AiFieldProposal[]
  obligations         Obligation[]
  occurrences         ObligationOccurrence[]
  payments            ObligationPayment[]
  ledgerEntries       ExpenseLedgerEntry[]
  assessmentSnapshots AssessmentSnapshot[]
  assessmentItems     AssessmentItem[]
  maintenanceEvents   MaintenanceEvent[]
  maintenanceDocuments MaintenanceDocumentLink[]
  shareOperations     ShareOperation[]
  notificationPreferences NotificationPreference[]
  searchProjections   SearchProjection[]
  exportPackages      ExportPackage[]
  exportPackageItems  ExportPackageItem[]
  assistantRequests   AssistantRequest[]
  scenarioManifests   ScenarioManifest[]
  saleWorkspaces      SaleWorkspace[]
  offerRevisions      OfferRevision[]
  termsRevisions      TermsRevision[]
  financingCases      FinancingCase[]
  paymentPlanLines    PaymentPlanLine[]
  transactionMoney    TransactionMoneyRecord[]
  transactionVisits   TransactionVisit[]
  transactionHandovers TransactionHandover[]
  dealRooms           DealRoom[]
  dealNotes           DealNote[]
  transactionGuidance TransactionGuidance[]

  @@index([ownerUserId])
}

// Buyer-controlled prospect records, never owned Property Passports.
model PurchaseWorkspace {
  id String @id
  workspaceId String
  name String
  version Int @default(0)
  requestKey String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidates PurchaseCandidate[]
  @@unique([id, workspaceId])
}

model PurchaseCandidate {
  documents PropertyDoc[]
  id String @id
  purchaseWorkspaceId String
  workspaceId String
  name String
  propertyType String?
  location String?
  areaValue String?
  areaUnit String?
  askingPricePaise BigInt?
  budgetPaise BigInt?
  source String?
  notes String?
  stage String @default("CONSIDERING")
  transactionPhase String?
  lifecycle String @default("ACTIVE")
  linkedPropertyId String?
  version Int @default(0)
  requestKey String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseWorkspace PurchaseWorkspace @relation(fields: [purchaseWorkspaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  entries PurchaseEntry[]
  offers OfferRevision[]
  terms TermsRevision[]
  financing FinancingCase?
  paymentPlanLines PaymentPlanLine[]
  moneyRecords TransactionMoneyRecord[]
  visits TransactionVisit[]
  handover TransactionHandover?
  @@unique([id, workspaceId])
  @@index([purchaseWorkspaceId])
}

model PurchaseEntry {
  version Int @default(0)
  state String @default("OPEN")
  events PurchaseEvidenceEvent[]
  id String @id
  candidateId String
  workspaceId String
  kind String
  body String
  dueDate String?
  requestKey String @unique
  createdAt DateTime @default(now())
  candidate PurchaseCandidate @relation(fields: [candidateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  @@index([candidateId, createdAt])
}

model Property {
  id                  String                 @id
  workspaceId         String
  name                String
  type                String
  city                String
  area                String
  address             String
  jurisdiction        String                 @default("")
  areaValue           String?
  areaUnit            String?
  areaType            String?
  ownershipAssertion  String                 @default("self_asserted")
  ownershipProvenance String                 @default("")
  identifiers         Json?
  carpetAreaSqft      Int?
  plotSizeSqft        Int?
  ownerName           String
  purchaseDate        String?
  purchaseValuePaise  BigInt?
  loanActive          Boolean                @default(false)
  loanBalancePaise    BigInt?
  insuranceUntil      String?
  occupancy           String?
  photoUrl            String?
  coOwners            String?
  rentAmountPaise     BigInt?
  status              String                 @default("active")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  version             Int                    @default(0)
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  docs                PropertyDoc[]
  bills               Bill[]
  maintenance         Maintenance[]
  timeline            TimelineEvent[]
  shares              ShareLink[]
  tenants             Tenant[]
  bookings            Booking[]
  reminders           Reminder[]
  durableReminders    DurableReminder[]
  listings            Listing[]
  projects            ConstructionProject[]
  history             PropertyHistory[]
  obligations         Obligation[]
  occurrences         ObligationOccurrence[]
  payments            ObligationPayment[]
  ledgerEntries       ExpenseLedgerEntry[]
  assessmentSnapshots AssessmentSnapshot[]
  maintenanceEvents  MaintenanceEvent[]
  maintenanceDocuments MaintenanceDocumentLink[]
  shareOperations    ShareOperation[]
  searchProjections SearchProjection[]
  exportPackages    ExportPackage[]
  exportPackageItems ExportPackageItem[]
  assistantRequests AssistantRequest[]
  saleWorkspaces SaleWorkspace[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
}

model PropertyHistory {
  id            String    @id
  workspaceId   String
  propertyId    String
  actorUserId   String
  field         String
  previousValue Json?
  nextValue     Json?
  source        String
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property      Property  @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, propertyId, createdAt])
}

model PurchaseEvidenceEvent {
  id String @id
  entryId String
  action String
  note String
  source String
  actorUserId String
  documentVersionId String?
  requestKey String @unique
  payloadHash String
  createdAt DateTime @default(now())
  entry PurchaseEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  @@index([entryId, createdAt])
}

model PropertyDoc {
  purchaseCandidateId String?
  purchaseCandidate PurchaseCandidate? @relation(fields: [purchaseCandidateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  constructionLinks ConstructionDocumentLink[]
  id               String               @id
  workspaceId      String
  propertyId       String?
  type             String
  name             String
  originalFilename String               @default("")
  displayName      String               @default("")
  subtype          String?
  provenance       String               @default("user_uploaded")
  // T02 post-purchase import lineage. Set only on copies created by the
  // explicit import executor; the seller/candidate originals are never moved.
  sourceDocumentId String?
  sourceVersionId  String?
  sourceSha256     String               @default("")
  sourceCandidateId String?
  uploadedBy       String?
  uploadDate       String
  sizeBytes        Int
  sha256           String               @default("")
  storageKey       String
  mimeType         String
  processingState  String               @default("awaiting_review")
  scanStatus       String               @default("scan_pending")
  reviewStatus     String               @default("awaiting_review")
  archivedAt       DateTime?
  deletedAt        DateTime?
  idempotencyKey   String?              @unique
  verified         Boolean              @default(false)
  notes            String?
  extracted        Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  version          Int                  @default(0)
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property         Property?            @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  versions         DocumentVersion[]
  parsingRuns      DocumentParsingRun[]
  ocrRuns          DocumentOcrRun[]
  aiRuns           AiExtractionRun[]
  proposals        AiFieldProposal[]
  maintenanceDocumentLinks MaintenanceDocumentLink[]
  shareOperations  ShareOperation[]
  searchProjections SearchProjection[]
  exportPackageItems ExportPackageItem[]

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId])
}

model DocumentVersion {
  purchaseEvidenceEvents PurchaseEvidenceEvent[]
  scanEvidence DocumentScanEvidence[]
  constructionLinks ConstructionDocumentLink[]
  id               String               @id
  workspaceId      String
  documentId       String
  version          Int
  originalFilename String
  displayName      String
  mimeType         String
  sizeBytes        Int
  sha256           String
  storageKey       String
  scanStatus       String
  processingState  String
  reviewStatus     String
  source           String               @default("user_uploaded")
  uploadedBy       String
  uploadedAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document         PropertyDoc          @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  parsingRuns      DocumentParsingRun[]
  ocrRuns          DocumentOcrRun[]
  aiRuns           AiExtractionRun[]
  proposals        AiFieldProposal[]
  maintenanceDocumentLinks MaintenanceDocumentLink[]
  searchProjections SearchProjection[]
  exportPackageItems ExportPackageItem[]

  @@unique([id, workspaceId])
  @@unique([documentId, version])
  @@index([workspaceId, documentId, version])
}

model DocumentScanEvidence {
  id                String @id
  documentVersionId String
  jobId             String
  attempt           Int
  evidence          Json
  createdAt         DateTime @default(now())
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([jobId, attempt])
  @@index([documentVersionId, createdAt])
}

// S19: private PostgreSQL search projection. Rows are workspace-scoped and
// only contain active clean document metadata plus approved parsed text.
// Nothing here is a public/global index and searchable text is never returned
// unless the caller is authorized for the source document.
model SearchProjection {
  id                 String          @id
  workspaceId        String
  propertyId         String
  documentId         String?
  documentVersionId  String?
  entityType         String
  sourceType         String
  title              String
  category           String?
  searchableText     String?
  searchableChunks   Json?
  searchableTextChars Int             @default(0)
  reviewState        String
  visibilityState    String           @default("ACTIVE")
  archivedAt         DateTime?
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property           Property         @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  document           PropertyDoc?     @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  documentVersion    DocumentVersion? @relation(fields: [documentVersionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([workspaceId, entityType, propertyId, documentId, documentVersionId])
  @@index([workspaceId, propertyId, entityType, visibilityState])
  @@index([workspaceId, updatedAt])
}

model DocumentParsingRun {
  id                String          @id
  workspaceId       String
  documentId        String
  documentVersionId String
  idempotencyKey    String          @unique
  status            String
  method            String
  parserVersion     String
  pageCount         Int?
  textChars         Int             @default(0)
  textChunks        Json?
  error             Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document          PropertyDoc     @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version           DocumentVersion @relation(fields: [documentVersionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, documentId, createdAt])
}

model DocumentOcrRun {
  id                  String          @id
  workspaceId         String
  documentId          String
  documentVersionId   String
  idempotencyKey      String          @unique
  status              String
  method              String
  providerEnvironment String
  pageCount           Int?
  textChars           Int             @default(0)
  textChunks          Json?
  error               Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  workspace           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document            PropertyDoc     @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version             DocumentVersion @relation(fields: [documentVersionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, documentId, createdAt])
}

model AiExtractionRun {
  id                  String            @id
  workspaceId         String
  documentId          String
  documentVersionId   String
  parsingRunId        String?
  idempotencyKey      String            @unique
  status              String
  method              String
  providerEnvironment String
  response            Json?
  error               Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document            PropertyDoc       @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version             DocumentVersion   @relation(fields: [documentVersionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  proposals           AiFieldProposal[]

  @@unique([id, workspaceId])
  @@index([workspaceId, documentId, createdAt])
}

model AiFieldProposal {
  id                String          @id
  workspaceId       String
  runId             String
  documentId        String
  documentVersionId String
  fieldName         String
  proposedValue     Json
  acceptedValue     Json?
  state             String          @default("proposed")
  sourcePage        Int?
  sourceChunk       String?
  extractionMethod  String
  confidence        Json?
  evidence          Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run               AiExtractionRun @relation(fields: [runId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  document          PropertyDoc     @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version           DocumentVersion @relation(fields: [documentVersionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, documentId, state])
}

model Bill {
  id           String    @id
  workspaceId  String
  propertyId   String
  type         String
  title        String
  amountPaise  BigInt
  dueDate      String
  paidDate     String?
  status       String
  receiptDocId String?
  recurring    String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  version      Int       @default(0)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property     Property  @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId, status])
}

model Maintenance {
  id             String    @id
  workspaceId    String
  propertyId     String
  task           String
  dateReported   String
  provider       String?
  quotePaise     BigInt?
  finalCostPaise BigInt?
  status         String
  warrantyUntil  String?
  notes          String?
  category       String    @default("Other")
  description    String?
  location       String?
  priority       String    @default("NORMAL")
  contactDetails String?
  dateStarted    String?
  dateCompleted  String?
  source         String    @default("OWNER_REPORTED")
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(0)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property       Property  @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  events         MaintenanceEvent[]
  documentLinks  MaintenanceDocumentLink[]
  invoiceObligation Obligation?

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId])
}

model TimelineEvent {
  id          String    @id
  workspaceId String
  propertyId  String
  date        String
  title       String
  detail      String?
  kind        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property    Property  @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId, date])
}

model ShareLink {
  id          String           @id
  workspaceId String
  propertyId  String
  grantorId   String
  role        String
  inviteeEmail String          @default("")
  inviteeUserId String?
  acceptedAt  DateTime?
  tokenHash   String           @unique
  expiresAt   String
  revokedAt   DateTime?
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  version     Int              @default(0)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property    Property         @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  scopes      ShareLinkScope[]
  operations  ShareOperation[]

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId])
}

model ShareLinkScope {
  id          String    @id
  shareLinkId String
  docType     String?
  documentId  String?
  scopeType   String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId])
}

model Tenant {
  id              String    @id
  workspaceId     String
  propertyId      String
  name            String
  phone           String?
  rentAmountPaise BigInt
  depositPaise    BigInt?
  startDate       String
  endDate         String
  status          String
  agreementDocId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  version         Int       @default(0)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property        Property  @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId, status])
}

model Booking {
  id          String    @id
  workspaceId String
  propertyId  String
  category    String
  vendor      String?
  date        String
  status      String
  costPaise   BigInt?
  rating      Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property    Property  @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId])
}

model Reminder {
  id          String    @id
  workspaceId String
  propertyId  String
  kind        String
  title       String
  dueDate     String
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property    Property  @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId, done])
}

// S16: durable, truthful reminder instances derived from manual obligations
// or explicitly selected property deadlines. Delivery is tracked separately
// from scheduling and never claims external delivery without provider proof.
model DurableReminder {
  id             String                @id
  workspaceId    String
  propertyId     String
  sourceType     String
  sourceId       String
  obligationId   String?
  occurrenceId   String?
  offsetDays     Int
  scheduledAt    DateTime
  timezone       String
  localTime      String
  channel        String
  state          String                @default("SCHEDULED")
  readAt         DateTime?
  snoozedUntil   DateTime?
  attemptCount   Int                   @default(0)
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  failureState   String?
  failureReason  String?
  idempotencyKey String                @unique
  deepLink       String
  title          String
  body           String
  version        Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property       Property              @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  obligation     Obligation?           @relation(fields: [obligationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  occurrence     ObligationOccurrence? @relation(fields: [occurrenceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  attempts       ReminderAttempt[]

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId, state, scheduledAt])
  @@index([obligationId, occurrenceId, channel])
}

model NotificationPreference {
  id          String   @id
  workspaceId String
  channel     String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channel])
  @@index([workspaceId, enabled])
}

model ReminderAttempt {
  id              String          @id
  workspaceId     String
  reminderId      String
  attemptNumber   Int
  state           String
  providerOutcome String?
  providerMessageId String?
  attemptedAt     DateTime        @default(now())
  deliveredAt     DateTime?
  failureReason   String?
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now())
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reminder        DurableReminder @relation(fields: [reminderId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([reminderId, attemptNumber])
  @@index([workspaceId, reminderId, attemptedAt])
}

model MaintenanceEvent {
  id            String      @id
  workspaceId   String
  propertyId    String
  maintenanceId String
  eventType     String
  fromStatus    String?
  toStatus      String?
  detail        Json?
  idempotencyKey String     @unique
  createdAt     DateTime    @default(now())
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property      Property    @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  maintenance   Maintenance @relation(fields: [maintenanceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, propertyId, maintenanceId, createdAt])
}

model MaintenanceDocumentLink {
  id               String          @id
  workspaceId      String
  propertyId       String
  maintenanceId    String
  documentId       String
  documentVersionId String?
  linkType         String
  createdAt        DateTime        @default(now())
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property         Property        @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  maintenance      Maintenance     @relation(fields: [maintenanceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  document         PropertyDoc     @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  documentVersion  DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  @@unique([maintenanceId, documentId, linkType])
  @@index([workspaceId, propertyId, maintenanceId])
}

// S18: an identity-bound grant. The token is invitation-only and is never a
// permanent public document URL. Capabilities are stored in ShareLinkScope.
model ShareOperation {
  id             String      @id
  workspaceId    String
  propertyId     String
  shareLinkId    String
  documentId     String
  requestedByUserId String
  status         String
  output        Json?
  failureReason  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property       Property    @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  shareLink      ShareLink   @relation(fields: [shareLinkId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  document       PropertyDoc @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  requestedBy    User        @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, propertyId, shareLinkId, createdAt])
}

// S21: selected export package and its authenticated temporary artifact.
model ExportPackage {
  id                    String             @id
  workspaceId           String
  propertyId            String
  requestedByUserId     String
  status                String             @default("QUEUED")
  includePropertyMetadata Boolean          @default(false)
  selectionHash         String
  artifactStorageKey    String?
  artifactSha256        String?
  artifactSizeBytes     Int?
  expiresAt             DateTime
  generatedAt           DateTime?
  revokedAt             DateTime?
  failureReason         String?
  manifest              Json?
  idempotencyKey        String             @unique
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property              Property           @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  requestedBy           User               @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  items                 ExportPackageItem[]

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId, status, expiresAt])
  @@index([requestedByUserId, createdAt])
}

model ExportPackageItem {
  id                String         @id
  workspaceId       String
  packageId         String
  propertyId        String
  documentId        String
  documentVersionId String
  sourceType        String
  createdAt         DateTime       @default(now())
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  package            ExportPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  property           Property       @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  document           PropertyDoc    @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  documentVersion    DocumentVersion @relation(fields: [documentVersionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([packageId, documentId, documentVersionId])
  @@index([workspaceId, propertyId, packageId])
}

// S20: no raw prompt or answer is persisted. This is an audit/rate-limit row
// containing only bounded metadata and the authorization context.
model AssistantRequest {
  id                 String     @id
  workspaceId        String
  requestedByUserId  String
  propertyId         String?
  providerEnvironment String
  outputState        String
  inputChars         Int
  retrievalCount     Int          @default(0)
