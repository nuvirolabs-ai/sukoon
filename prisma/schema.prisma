// S12: neutral, versioned content rules. These are deliberately global and
// contain typed applicability only; they are not a legal advice engine.
model ChecklistRule {
  revision Int @default(1)
  id                   String           @id
  stableKey            String
  version              Int
  contentType          String
  title                String
  description          String
  category             String
  jurisdiction         String?
  propertyType         String?
  ownershipContext     String?
  evidenceCategory     String?
  requiresConfirmation Boolean          @default(false)
  effectiveFrom        String
  effectiveUntil       String?
  sourceName           String?
  sourceReference      Json?
  sourcePublishedDate  String?
  reviewer             String?
  reviewedAt           DateTime?
  status               String           @default("DRAFT")
  supersedesId         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  supersedes           ChecklistRule?   @relation("RuleSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy         ChecklistRule[]  @relation("RuleSupersession")
  auditEvents          RuleAuditEvent[]
  assessmentItems      AssessmentItem[]

  @@unique([stableKey, version])
  @@index([status, effectiveFrom, effectiveUntil])
  @@index([stableKey, status])
}

// S22: reviewed buyer education is global content, separate from private
// property data. Only current PUBLISHED rows are exposed to the app.
model EducationContent {
  id            String   @id
  slug          String   @unique
  contentType   String
  title         String
  summary       String
  body          Json
  sourceName    String
  sourceReference Json
  reviewer      String
  reviewedAt    DateTime
  effectiveFrom String
  expiresAt     String?
  status        String   @default("DRAFT")
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contentType, status, effectiveFrom, expiresAt])
}

model RuleAuditEvent {
  id          String        @id
  ruleId      String
  actorUserId String
  action      String
  fromStatus  String?
  toStatus    String?
  detail      Json?
  createdAt   DateTime      @default(now())
  rule        ChecklistRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  actor       User          @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  @@index([actorUserId, createdAt])
}

// S13: append-only explainable assessment snapshots. Each run creates a new
// snapshot and copies the stable rule/version identifiers into its items.
model AssessmentSnapshot {
  id              String           @id
  workspaceId     String
  propertyId      String
  propertyVersion Int
  assessment      String
  score           Int?
  applicableCount Int
  satisfiedCount  Int
  unknownCount    Int
  evaluatedAt     DateTime         @default(now())
  createdAt       DateTime         @default(now())
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property        Property         @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  items           AssessmentItem[]
  evaluator       User?            @relation(fields: [evaluatorUserId], references: [id], onDelete: SetNull)
  evaluatorUserId String?

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId, evaluatedAt])
}

model AssessmentItem {
  id                        String             @id
  workspaceId               String
  snapshotId                String
  propertyId                String
  ruleId                    String?
  ruleStableKey             String
  ruleVersion               Int?
  requirement               String
  applicability             String
  evidenceState             String
  evidenceDocumentId        String?
  evidenceDocumentVersionId String?
  contribution              String
  result                    String
  suggestedAction           String?
  explanation               String
  createdAt                 DateTime           @default(now())
  workspace                 Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot                  AssessmentSnapshot @relation(fields: [snapshotId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  rule                      ChecklistRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId, evidenceState])
  @@index([snapshotId, workspaceId])
}

// S14: manual-first, property-linked obligations. Dates are date-only ISO
// values; recurrence is generated into idempotent cycle occurrences.
model Obligation {
  constructionCost ConstructionCost?
  id             String                 @id
  workspaceId    String
  propertyId     String
  type           String
  label          String
  direction      String
  amountPaise    BigInt?
  currency       String
  dueDate        String
  timezone       String
  recurrenceType String
  recurrenceDay  Int?
  source         String                 @default("USER_ENTERED")
  notes          String?
  reminderConfig Json?
  maintenanceId String? @unique
  active         Boolean                @default(true)
  version        Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property       Property               @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  occurrences    ObligationOccurrence[]
  payments       ObligationPayment[]
  durableReminders DurableReminder[]
  maintenance   Maintenance? @relation(fields: [maintenanceId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([id, workspaceId])
  @@unique([maintenanceId, workspaceId])
  @@index([workspaceId, propertyId, active, dueDate])
}

model ObligationOccurrence {
  id           String              @id
  workspaceId  String
  propertyId   String
  obligationId String
  cycleKey     String
  dueDate      String
  amountPaise  BigInt?
  currency     String
  status       String              @default("OPEN")
  source       String              @default("GENERATED")
  version      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property     Property            @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  obligation   Obligation          @relation(fields: [obligationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  payments     ObligationPayment[]
  durableReminders DurableReminder[]

  @@unique([obligationId, cycleKey])
  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId, dueDate, status])
}

// S15: no gateway credentials or provider state; only owner-entered records.
model ObligationPayment {
  id                       String               @id
  workspaceId              String
  propertyId               String
  obligationId             String
  occurrenceId             String
  amountPaise              BigInt
  currency                 String
  paymentDate              String
  method                   String
  status                   String               @default("RECORDED")
  source                   String               @default("USER_ENTERED")
  notes                    String?
  idempotencyKey           String               @unique
  receiptDocumentId        String?
  receiptDocumentVersionId String?
  reversedAt               DateTime?
  reversalOfId             String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  version                  Int                  @default(0)
  workspace                Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property                 Property             @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  obligation               Obligation           @relation(fields: [obligationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  occurrence               ObligationOccurrence @relation(fields: [occurrenceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  reversalOf               ObligationPayment?   @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals                ObligationPayment[]  @relation("PaymentReversal")
  ledgerEntry              ExpenseLedgerEntry?

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId, occurrenceId, status])
}

model ExpenseLedgerEntry {
  constructionCost ConstructionCost?
  id           String             @id
  workspaceId  String
  propertyId   String
  paymentId    String?            @unique
  obligationId String?
  occurrenceId String?
  amountPaise  BigInt
  currency     String
  entryType    String
  canonicalKey String             @unique
  // Construction corrections retain the original and append signed ledger effects.
  reversalOfId String?            @unique
  replacementForId String?        @unique
  correctionReason String?
  actorUserId String?
  reversalOf ExpenseLedgerEntry? @relation("LedgerReversal", fields: [reversalOfId, workspaceId, propertyId], references: [id, workspaceId, propertyId], onDelete: NoAction, onUpdate: NoAction)
  reversals ExpenseLedgerEntry[] @relation("LedgerReversal")
  replacementFor ExpenseLedgerEntry? @relation("LedgerReplacement", fields: [replacementForId, workspaceId, propertyId], references: [id, workspaceId, propertyId], onDelete: NoAction, onUpdate: NoAction)
  replacements ExpenseLedgerEntry[] @relation("LedgerReplacement")
  createdAt    DateTime           @default(now())
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property     Property           @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  payment      ObligationPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, propertyId, createdAt])
  @@unique([id, workspaceId, propertyId])
}

model ConsentRecord {
  id            String    @id
  userId        String
  purpose       String
  policyVersion String
  grantedAt     DateTime
  withdrawnAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model ProcessingControl {
  workspaceId String @id
  withdrawnAt DateTime
  noticeVersion String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Request intake only: execution awaits an approved retention/export policy.
model PrivacyRequest {
  exportScope String?
  expiresAt DateTime?
  artifactKey String?
  artifactSha256 String?
  failureCode String?
  completedAt DateTime?
  id          String   @id
  userId      String
  kind        String
  propertyId  String?
  requestKey  String
  status      String   @default("AWAITING_POLICY")
  createdAt   DateTime @default(now())
  cancelledAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
}

model IdempotencyRecord {
  id              String   @id
  principalUserId String
  action          String
  requestKey      String
  payloadHash     String
  response        Json
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [principalUserId], references: [id], onDelete: Cascade)

  @@unique([principalUserId, action, requestKey])
  @@index([principalUserId, createdAt])
}

model OutboxEvent {
  id             String      @id
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  idempotencyKey String?     @unique
  correlationId  String?
  status         String      @default("queued")
  attempts       Int         @default(0)
  maxAttempts    Int         @default(3)
  nextAttemptAt  DateTime    @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  startedAt      DateTime?
  completedAt    DateTime?
  lastError      Json?
  deadLetteredAt DateTime?
  createdAt      DateTime    @default(now())
  processedAt    DateTime?
  effects        JobEffect[]

  @@index([status, nextAttemptAt, createdAt])
  @@index([lockedAt, status])
  @@index([aggregateType, aggregateId])
}

model JobEffect {
  id            String      @id
  jobId         String      @unique
  effectKey     String      @unique
  aggregateType String
  aggregateId   String
  result        Json?
  createdAt     DateTime    @default(now())
  job           OutboxEvent @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([aggregateType, aggregateId])
}

model WorkerHeartbeat {
  id              String   @id
  environment     String
  status          String
  startedAt       DateTime
  lastSeenAt      DateTime
  lastCompletedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([environment, lastSeenAt])
}

// Namespaced demo manifests. Payloads stay stable across reruns.
model ScenarioManifest {
  id String @id
  namespace String
  workspaceId String
  subjectType String
  subjectId String @default("")
  anchorDate String
  fingerprint String
  status String
  report Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([namespace, workspaceId, subjectType])
  @@index([workspaceId])
}

model SaleWorkspace {
  id String @id
  workspaceId String
  propertyId String
  askingPricePaise BigInt?
  possessionTargetDate String?
  description String @default("")
  phase String @default("CONSIDERING")
  lifecycle String @default("ACTIVE")
  version Int @default(0)
  requestKey String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  prospects SaleProspect[]
  offers OfferRevision[]
  terms TermsRevision[]
  paymentPlanLines PaymentPlanLine[]
  moneyRecords TransactionMoneyRecord[]
  handover TransactionHandover?

  @@unique([id, workspaceId])
  @@index([workspaceId, propertyId])
}

model SaleProspect {
  id String @id
  saleWorkspaceId String
  workspaceId String
  name String
  source String?
  privateNotes String @default("")
  status String @default("INTERESTED")
  version Int @default(0)
  requestKey String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  saleWorkspace SaleWorkspace @relation(fields: [saleWorkspaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  offers OfferRevision[]
  visits TransactionVisit[]

  @@unique([id, workspaceId])
  @@index([saleWorkspaceId])
}

model OfferRevision {
  id String @id
  workspaceId String
  candidateId String?
  prospectId String?
  saleWorkspaceId String?
  amountPaise BigInt
  currency String @default("INR")
  authorSource String
  previousOfferId String?
  status String @default("RECORDED")
  termsSnapshot Json
  offeredOn String
  requestKey String @unique
  payloadHash String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate PurchaseCandidate? @relation(fields: [candidateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  prospect SaleProspect? @relation(fields: [prospectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  saleWorkspace SaleWorkspace? @relation(fields: [saleWorkspaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, candidateId])
  @@index([workspaceId, prospectId])
}

model TermsRevision {
  id String @id
  workspaceId String
  candidateId String?
  prospectId String?
  saleWorkspaceId String?
  revision Int
  snapshot Json
  requestKey String @unique
  payloadHash String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate PurchaseCandidate? @relation(fields: [candidateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  saleWorkspace SaleWorkspace? @relation(fields: [saleWorkspaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  acknowledgements TermsAcknowledgement[]

  @@index([workspaceId, candidateId])
}

model TermsAcknowledgement {
  id String @id
  workspaceId String
  termsRevisionId String
  actorUserId String
  acknowledgementType String
  createdAt DateTime @default(now())
  termsRevision TermsRevision @relation(fields: [termsRevisionId], references: [id], onDelete: Cascade)

  @@unique([termsRevisionId, actorUserId, acknowledgementType])
  @@index([workspaceId])
}

model FinancingCase {
  id String @id
  workspaceId String
  candidateId String
  status String @default("NOT_STARTED")
  sourceOfFunds String?
  requestedPaise BigInt?
  sanctionedPaise BigInt?
  disbursedPaise BigInt?
  conditions String @default("")
  version Int @default(0)
  requestKey String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate PurchaseCandidate @relation(fields: [candidateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([candidateId, workspaceId])
}

model PaymentPlanLine {
  id String @id
  workspaceId String
  candidateId String?
  saleWorkspaceId String?
  label String
  amountPaise BigInt
  dueDate String?
  classification String
  requestKey String @unique
  payloadHash String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate PurchaseCandidate? @relation(fields: [candidateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  saleWorkspace SaleWorkspace? @relation(fields: [saleWorkspaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, candidateId])
}

model TransactionMoneyRecord {
  id String @id
  workspaceId String
  candidateId String?
  saleWorkspaceId String?
  amountPaise BigInt
  currency String @default("INR")
  kind String
  allocation String
  reversalOfId String? @unique
  occurredOn String
  source String
  requestKey String @unique
  note String @default("")
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate PurchaseCandidate? @relation(fields: [candidateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  saleWorkspace SaleWorkspace? @relation(fields: [saleWorkspaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  reversalOf TransactionMoneyRecord? @relation("TransactionMoneyReversal", fields: [reversalOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversals TransactionMoneyRecord[] @relation("TransactionMoneyReversal")

  @@index([workspaceId, candidateId])
}

model TransactionVisit {
  id String @id
  workspaceId String
  candidateId String?
  prospectId String?
  startsOn String
  timezone String @default("Asia/Kolkata")
  contactName String?
  notes String @default("")
  observations String @default("")
  status String @default("PLANNED")
  requestKey String @unique
  payloadHash String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate PurchaseCandidate? @relation(fields: [candidateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  prospect SaleProspect? @relation(fields: [prospectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, candidateId])
}

model TransactionHandover {
  id String @id
  workspaceId String
  candidateId String?
  saleWorkspaceId String?
  status String @default("NOT_STARTED")
  plannedDate String?
  version Int @default(0)
  snapshot Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate PurchaseCandidate? @relation(fields: [candidateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  saleWorkspace SaleWorkspace? @relation(fields: [saleWorkspaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  items TransactionHandoverItem[]

  @@unique([candidateId, workspaceId])
  @@unique([saleWorkspaceId, workspaceId])
}

model TransactionHandoverItem {
  id String @id
  handoverId String
  workspaceId String
  label String
  disposition String @default("OPEN")
  note String @default("")
  handover TransactionHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@unique([handoverId, label])
  @@index([workspaceId])
}

model DealRoom {
  id String @id
  workspaceId String
  subjectType String
  subjectId String
  version Int @default(0)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grants DealGrant[]
  notes DealNote[]
  disclosures DealDisclosure[]

  @@unique([workspaceId, subjectType, subjectId])
}

model DealGrant {
  id String @id
  roomId String
  workspaceId String
  inviteeEmail String
  inviteeUserId String?
  roleLabel String
  capabilities String[]
  status String @default("INVITED")
  tokenHash String
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  requestKey String @unique
  createdAt DateTime @default(now())
  room DealRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([inviteeUserId, status])
  @@index([workspaceId])
}

model DealNote {
  id String @id
  roomId String?
  workspaceId String
  authorUserId String
  audience String
  body String
  requestKey String @unique
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room DealRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([workspaceId, audience])
}

model DealDisclosure {
  id String @id
  roomId String
  workspaceId String
  factKey String
  factValue String
  expiresAt DateTime?
  revokedAt DateTime?
  requestKey String @unique
  createdAt DateTime @default(now())
  room DealRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model TransactionGuidance {
  id String @id
  workspaceId String
  ruleKey String
  subjectType String
  subjectId String
  relevanceKey String
  title String
  href String
  dueDate String?
  state String @default("ACTIVE")
  sourceFingerprint String
  evaluatedAt DateTime
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, ruleKey, subjectType, subjectId, relevanceKey])
  @@index([workspaceId, state])
}
