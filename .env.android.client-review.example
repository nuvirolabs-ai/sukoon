# Android CLIENT_REVIEW profile. The build script injects these values and
# writes no credentials. Keep this template; do not commit a local copy.
SUKOON_RUNTIME_PROFILE=CLIENT_REVIEW
SUKOON_CLIENT_REVIEW_ORIGIN=https://<machine>.<tailnet>.ts.net
SUKOON_ANDROID_SERVER_URL=https://<machine>.<tailnet>.ts.net
NEXT_PUBLIC_SUKOON_API_BASE_URL=https://<machine>.<tailnet>.ts.net
SUKOON_TRUSTED_ORIGINS=https://<machine>.<tailnet>.ts.net
BETTER_AUTH_TRUSTED_ORIGINS=https://<machine>.<tailnet>.ts.net
