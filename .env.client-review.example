# Private Mac-only client review settings. Copy to .env.client-review.local.
# Never commit the local copy or the access code.
SUKOON_RUNTIME_PROFILE=CLIENT_REVIEW
SUKOON_CLIENT_REVIEW_ORIGIN=https://tanutejass-macbook-pro.tail535562.ts.net
BETTER_AUTH_URL=https://tanutejass-macbook-pro.tail535562.ts.net
BETTER_AUTH_TRUSTED_ORIGINS=https://tanutejass-macbook-pro.tail535562.ts.net
SUKOON_TRUSTED_ORIGINS=https://tanutejass-macbook-pro.tail535562.ts.net
TAILSCALE_PATH=/usr/local/bin/tailscale
# This single allowlisted account must be seeded with npm run client-review:seed.
SUKOON_CLIENT_REVIEW_EMAIL=akshay-review@sukoon.local
# Generate locally with: npm run client-review:generate-code
SUKOON_CLIENT_REVIEW_ACCESS_CODE=<paste-the-strong-code-here>
